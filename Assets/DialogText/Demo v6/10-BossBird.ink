INCLUDE globals.ink
// EXTERNAL playEmote(emoteName)

{ lang == "zh":
    #speaker:鄔詩
- else:
    #speaker:Wushi
}
#portrait:wushi-shock #layout:layout1 #audio:wushi
{ lang == "zh":
    就是這個家夥！
- else:
    This is it!
}

{ lang == "zh":
    #speaker:黑
- else:
    #speaker:Black
}
#portrait:god-1 #audio:default
{ lang == "zh":
    聽著，這孩子和你之前遇到的念頭都不一樣。
- else:
    Listen, kid, this one is nothing like the thoughts you've faced before. 
}
{ lang == "zh":
    好好運用我們的力量，找到它的弱點。
- else:
    Make good use of our power and find its weakness.
}

{ lang == "zh":
    #speaker:白
- else:
    #speaker:White
}
#portrait:god-2 
{ lang == "zh":
    小心別受傷了。
- else:
    Don't get yourself hurt.
}
-> END

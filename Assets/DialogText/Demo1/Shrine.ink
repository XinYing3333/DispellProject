INCLUDE globals.ink
// EXTERNAL playEmote(emoteName)

{ lang == "zh":
    #speaker:鄔詩
- else:
    #speaker:Wushi
}
#portrait:wushi-scorn #layout:layout2 #audio:none
{ lang == "zh":
    「這個年代居然還能在路邊看到神龕。」
- else:
    Still by the roadside… even now.
}

{ lang == "zh":
    「裏面在供奉著什麽呢？」
- else:
    What could be enshrined here?
}

-> END

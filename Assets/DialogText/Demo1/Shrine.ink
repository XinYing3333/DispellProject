INCLUDE globals.ink
// EXTERNAL playEmote(emoteName)

{ lang == "zh":
    #speaker:鄔詩
- else:
    #speaker:Wushi
}
#portrait:wushi-scorn #layout:layout1 #audio:wushi
{ lang == "zh":
    「這是...神龕？」
- else:
    Is this... a shrine?
}

{ lang == "zh":
    「這個年代居然還能在路邊看到」
- else:
    Still by the roadside… even now.
}

{ lang == "zh":
    「裏面在供奉著什麽呢？」
- else:
    What could be enshrined here?
}

-> END
